{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      ".github/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/community.html" }
    ]
  }
}
